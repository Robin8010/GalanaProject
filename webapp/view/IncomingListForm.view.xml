<?xml version="1.0" encoding="UTF-8" ?>
<mvc:View
controllerName="project1.controller.IncomingListForm"
    height="100%"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:T="sap.ui.table"
    xmlns:u="sap.ui.unified"
    xmlns:c="sap.ui.core"
	xmlns:a="sap.ui.core.Control"
>
   <Page
        id="_DocList"
        class="sapUiFioriObjectPage" title=""
        showHeader="true" showNavButton="true" navButtonPress=".navBack"
    > 
     <content>
            <f:SimpleForm
                id="_DebitListForm"
                maxContainerCols="2"
                editable="true"
                layout="ResponsiveGridLayout"
                title="Incoming Payment"
                labelSpanL="4"
                labelSpanM="4"
                emptySpanL="0"
                backgroundDesign="Solid"
                emptySpanM="0"
                columnsL="2"
                columnsM="1"
                validateFieldGroup="onValidateFieldGroup"
            >
     <VBox id="Vbox" >
    <!-- Search Field for Filtering -->
   
    <!-- List to Display Items -->
  
  <Table id="_DebitTbl" items="{Debit>/value}"
  width="100%" 
    growing="true"
    growingScrollToLoad="true"
      class="sapUiSizeCompact"
                    sticky="ColumnHeaders,HeaderToolbar"
                    showSeparators="All"
                    showNoData="true"
                    growingThreshold="5"
                    enableBusyIndicator="true"
                    alternateRowColors="true"
                    headerLevel="Auto"                    
                    backgroundDesign="Translucent"
   >
  <headerToolbar>
  <Toolbar >
  <content>
 <!-- <SearchField placeholder="Code" width="30%" liveChange="onSearch"></SearchField>-->
  <SearchField placeholder="Name" width="30%" liveChange="onSearchWithName"></SearchField>
  <ToolbarSpacer ></ToolbarSpacer>
 <!-- <Button text="Addnew" type="Accept" press="Addnew"></Button>-->
  </content>
  </Toolbar>
  </headerToolbar>
							<columns>
           <!--   <Column>
									<Label visible="false" text="ID"/>
								</Column>-->
								<Column>
									<Label text="PaymentNo"/>
								</Column>
                	<Column>
									<Label text="Customer"/>
								</Column>
                	<Column>
									<Label text="CustomerFullName"/>
								</Column>
								<Column>
									<Label text="PaymentDate"/>
								</Column>
                	<Column>
									<Label text="Fiscal Year"/>
								</Column>
                
                  <Column hAlign="End">
									<Label text="Action"/>
								</Column>
               
							</columns>
							<items>
								<ColumnListItem>
									<cells >
                  	<Text text="{Debit>PaymentNo}"/>
										<Text text="{Debit>Customer}"/>
										<Text text="{Debit>CustomerFullName}"/>
                    <Text text="{Debit>PaymentDate}"/>
                     <Text text="{Debit>FiscalYear}"/>
                    <Button icon="sap-icon://print" type="Transparent" press="OnPrint"></Button>
									</cells>
								</ColumnListItem>
							</items>
						</Table>

  </VBox>  
   </f:SimpleForm>
     </content>
     
    </Page>
</mvc:View>